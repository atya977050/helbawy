    document.getElementById('page').style.display='block';
    document.getElementById('pageTitle').textContent='الحسابات';
    showAccounts();
    return;
  }

  if(name==='budget'){
    document.querySelectorAll('.menu button').forEach(b=>b.classList.remove('active'));
